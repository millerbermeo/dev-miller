---
import Button from "./ui/Button.astro";
import Icon from "./ui/Icon.astro";

const email = "devmiller25@gmail.com";
---

<section id="contact" aria-labelledby="contact-title" class="section-y">
  <div class="shell">
    <div data-reveal class="contact-panel relative isolate overflow-hidden rounded-panel bg-surface px-6 py-14 text-center shadow-card sm:px-12 sm:py-20 lg:py-24">
      <div class="contact-glow pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

      <p class="eyebrow mb-3">Contacto</p>
      <h2 id="contact-title" class="mx-auto max-w-2xl text-title-1 text-fg">
        ¿Tienes un proyecto o propuesta?
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lead text-muted">
        Disponible para proyectos freelance, posiciones de trabajo y
        colaboraciones. Respondo en menos de 24 horas.
      </p>

      <!-- Acción principal: correo (con opción de copiarlo) -->
      <div class="mt-10 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
        <Button href={`mailto:${email}`} size="lg" class="min-w-0">
          <Icon name="mail" class="size-4 shrink-0" />
          <span class="truncate">{email}</span>
        </Button>
        <Button
          variant="secondary"
          size="lg"
          id="copy-email"
          data-email={email}
          aria-describedby="copy-status"
        >
          <Icon name="copy" class="size-4" />
          <span data-copy-label>Copiar correo</span>
        </Button>
      </div>
      <p id="copy-status" class="sr-only" role="status" aria-live="polite"></p>

      <div class="mt-3 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
        <Button
          href="https://wa.me/573144295049?text=Hola%20Miller%2C%20me%20interesa%20tu%20trabajo"
          variant="secondary"
          size="lg"
          external
        >
          <Icon name="whatsapp" class="size-4 text-[#1fa855] dark:text-[#25d366]" />
          WhatsApp
        </Button>
        <Button href="/cvmillerrivera.pdf" variant="secondary" size="lg" external>
          <Icon name="download" class="size-4" />
          Descargar CV
        </Button>
      </div>

      <ul class="mt-10 flex items-center justify-center gap-1 border-t pt-8" aria-label="Redes profesionales">
        <li>
          <Button href="https://github.com/millerbermeo" variant="ghost" size="sm" external class="text-muted hover:text-fg">
            <Icon name="github" class="size-4" />
            GitHub
          </Button>
        </li>
        <li>
          <Button href="https://www.linkedin.com/in/miller-rivera/" variant="ghost" size="sm" external class="text-muted hover:text-fg">
            <Icon name="linkedin" class="size-4" />
            LinkedIn
          </Button>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .contact-glow {
    background:
      radial-gradient(40rem 20rem at 50% 0%, rgb(var(--accent-fill) / 0.14), transparent 70%),
      radial-gradient(30rem 16rem at 50% 110%, rgb(var(--accent) / 0.08), transparent 70%);
  }
</style>

<script>
  const btn = document.getElementById("copy-email") as HTMLButtonElement | null;
  const label = btn?.querySelector<HTMLElement>("[data-copy-label]");
  const status = document.getElementById("copy-status");
  let timer: number | undefined;

  btn?.addEventListener("click", async () => {
    const email = btn.dataset.email ?? "";
    let ok = true;
    try {
      await navigator.clipboard.writeText(email);
    } catch {
      ok = false;
    }
    if (label) label.textContent = ok ? "¡Copiado!" : "No se pudo copiar";
    if (status) status.textContent = ok ? `Correo ${email} copiado al portapapeles` : "No se pudo copiar el correo";
    window.clearTimeout(timer);
    timer = window.setTimeout(() => {
      if (label) label.textContent = "Copiar correo";
      if (status) status.textContent = "";
    }, 2200);
  });
</script>
