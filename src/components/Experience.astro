---
import SectionHeading from "./ui/SectionHeading.astro";
import Icon from "./ui/Icon.astro";

// Logros a nivel de rol. El detalle de cada proyecto vive en la sección Proyectos.
const achievements = [
  "Desarrollo de plataformas SaaS y POS multi-tenant en producción, con hasta 60% menos tiempo de gestión operativa para los negocios que las adoptaron.",
  "Integración de modelos de IA (OpenAI, Claude) y WhatsApp Business API para automatizar atención al cliente, con más del 70% de resolución autónoma.",
  "Sistemas de domicilios con asignación inteligente de pedidos: tiempos de asignación de minutos a segundos y trazabilidad completa.",
  "App Android de domicilios publicada en Google Play, construida con React Native + Expo y builds gestionados con EAS.",
  "Trabajo end-to-end: arquitectura, backend, frontend, mobile y despliegue en Linux con Docker y AWS.",
];
---

<section id="experience" aria-labelledby="experience-title" class="section-y">
  <div class="shell">
    <SectionHeading
      id="experience-title"
      eyebrow="Experiencia"
      title="Dónde he trabajado"
      description="3 años construyendo software de negocio, de la arquitectura al despliegue."
    />

    <article data-reveal class="card grid gap-8 p-6 sm:p-10 lg:grid-cols-12 lg:gap-12 lg:p-12" aria-labelledby="role-title">
      <!-- Rol -->
      <header class="lg:col-span-4">
        <span class="flex size-12 items-center justify-center rounded-2xl bg-accent-fill/12 text-accent">
          <Icon name="briefcase" class="size-6" />
        </span>
        <h3 id="role-title" class="mt-5 text-title-2 text-fg">Desarrollador de Software</h3>
        <p class="mt-1.5 text-headline font-medium text-fg/85">Desarrollo G</p>
        <p class="mt-1 text-callout text-muted">Empresa de tecnología · Soluciones a medida</p>
        <p class="mt-5 inline-flex items-center gap-2 rounded-full bg-success/10 px-3 py-1.5 text-footnote font-medium text-success">
          <span class="size-1.5 rounded-full bg-success" aria-hidden="true"></span>
          <time datetime="2023">2023</time> — Actualidad
        </p>
      </header>

      <!-- Logros -->
      <div class="lg:col-span-8 lg:border-l lg:pl-12">
        <h4 class="text-footnote font-semibold text-muted">Logros principales</h4>
        <ul class="mt-4 divide-y">
          {
            achievements.map((item) => (
              <li class="flex gap-3.5 py-4 text-callout text-fg/90 first:pt-0 last:pb-0 sm:text-base">
                <Icon name="check" class="mt-1 size-4 shrink-0 text-accent" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </article>
  </div>
</section>
