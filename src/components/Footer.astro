---
import Icon from "./ui/Icon.astro";
import Button from "./ui/Button.astro";

const year = new Date().getFullYear();

const links = [
  { label: "Sobre mí", href: "#about" },
  { label: "Proyectos", href: "#projects" },
  { label: "Experiencia", href: "#experience" },
  { label: "Servicios", href: "#services" },
  { label: "Contacto", href: "#contact" },
];
---

<footer class="border-t">
  <div class="shell flex flex-col gap-8 py-10 sm:py-12 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="text-headline font-semibold text-fg">Miller Rivera</p>
      <p class="mt-1 text-footnote text-muted">
        © {year} Miller Rivera · Desarrollador Fullstack &amp; IA
      </p>
    </div>

    <nav aria-label="Pie de página">
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="rounded-sm text-footnote text-muted transition-colors hover:text-fg">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <Button href="https://github.com/millerbermeo" variant="ghost" size="icon" external aria-label="GitHub de Miller Rivera" class="text-muted hover:text-fg">
        <Icon name="github" class="size-[1.125rem]" />
      </Button>
      <Button href="https://www.linkedin.com/in/miller-rivera/" variant="ghost" size="icon" external aria-label="LinkedIn de Miller Rivera" class="text-muted hover:text-fg">
        <Icon name="linkedin" class="size-[1.125rem]" />
      </Button>
      <Button href="mailto:devmiller25@gmail.com" variant="ghost" size="icon" aria-label="Enviar correo a Miller Rivera" class="text-muted hover:text-fg">
        <Icon name="mail" class="size-[1.125rem]" />
      </Button>
      <span class="mx-1 h-5 w-px bg-fg/10" aria-hidden="true"></span>
      <Button href="#home" variant="secondary" size="icon" aria-label="Volver arriba">
        <Icon name="arrow-up" class="size-[1.125rem]" />
      </Button>
    </div>
  </div>
</footer>
