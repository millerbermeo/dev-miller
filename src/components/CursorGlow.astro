---
// ─────────────────────────────────────────────────────────────
// CURSOR GLOW — halo muy tenue que sigue al puntero.
// · Solo con puntero fino (ratón/trackpad); nunca en táctil.
// · Desactivado con reduced-motion o reduced-transparency.
// · Se mueve con transform dentro de rAF (compositor, sin relayout).
// ─────────────────────────────────────────────────────────────
---

<div class="cursor-glow-layer" aria-hidden="true">
  <div class="cursor-glow-orb" id="cursor-glow-orb"></div>
</div>

<style>
  .cursor-glow-layer {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    contain: strict;
    display: none;
  }
  @media (pointer: fine) and (prefers-reduced-motion: no-preference) and (prefers-reduced-transparency: no-preference) {
    .cursor-glow-layer {
      display: block;
    }
  }
  .cursor-glow-orb {
    position: absolute;
    top: 0;
    left: 0;
    width: 520px;
    height: 520px;
    margin: -260px 0 0 -260px;
    border-radius: 9999px;
    transform: translate3d(-1000px, -1000px, 0);
    opacity: 0;
    transition: opacity 600ms var(--ease-out-soft);
    will-change: transform;
    background: radial-gradient(circle, rgb(var(--accent-fill) / 0.1), transparent 70%);
  }
  :global(html:not(.dark)) .cursor-glow-orb {
    background: radial-gradient(circle, rgb(var(--accent-fill) / 0.06), transparent 70%);
  }
  .cursor-glow-orb.is-active {
    opacity: 1;
  }
</style>

<script>
  const orb = document.getElementById("cursor-glow-orb");
  const enabled = window.matchMedia(
    "(pointer: fine) and (prefers-reduced-motion: no-preference) and (prefers-reduced-transparency: no-preference)",
  ).matches;

  if (orb && enabled) {
    let x = 0;
    let y = 0;
    let raf = 0;

    const render = () => {
      raf = 0;
      orb.style.transform = `translate3d(${x}px, ${y}px, 0)`;
    };

    window.addEventListener(
      "pointermove",
      (e) => {
        if (e.pointerType !== "mouse") return;
        x = e.clientX;
        y = e.clientY;
        orb.classList.add("is-active");
        if (!raf) raf = requestAnimationFrame(render);
      },
      { passive: true },
    );
    document.documentElement.addEventListener("pointerleave", () => orb.classList.remove("is-active"));
  }
</script>
