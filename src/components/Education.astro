---
import SectionHeading from "./ui/SectionHeading.astro";
import Icon from "./ui/Icon.astro";

// TODO(miller): reemplazar `institution` con el nombre real de cada institución.
const education = [
  {
    title: "Ingeniería de Software",
    institution: "Formación universitaria · en curso",
    period: "2025 — Presente",
    current: true,
    description:
      "Formación profesional en ingeniería de software con enfoque en arquitecturas modernas, diseño de sistemas escalables y metodologías ágiles.",
  },
  {
    title: "Tecnólogo en Análisis y Desarrollo de Software",
    institution: "SENA",
    period: "2022 — 2024",
    current: false,
    description:
      "Formación técnica integral en análisis, diseño, desarrollo e implementación de soluciones de software, con énfasis en metodologías ágiles y buenas prácticas de programación.",
  },
  {
    title: "Técnico en Sistemas",
    institution: "Formación técnica",
    period: "2020",
    current: false,
    description:
      "Formación técnica en fundamentos de sistemas informáticos, mantenimiento de equipos, redes básicas y soporte técnico.",
  },
];

const courses = [
  "Desarrollo Web (Platzi)",
  "JavaScript & Node.js (Platzi)",
  "Bases de Datos (Platzi)",
  "Python & APIs (Platzi)",
];
---

<section id="education" aria-labelledby="education-title" class="section-y">
  <div class="shell">
    <SectionHeading
      id="education-title"
      eyebrow="Formación"
      title="Formación académica"
      description="Base formal en ingeniería de software, reforzada con formación continua por cuenta propia."
    />

    <div class="grid gap-4 lg:grid-cols-12">
      <ol data-reveal class="card divide-y px-6 sm:px-8 lg:col-span-8">
        {
          education.map((item) => (
            <li class="grid gap-2 py-6 sm:grid-cols-[9rem_1fr] sm:gap-6 sm:py-7">
              <p class="text-footnote font-medium text-muted tabular-nums sm:pt-0.5">{item.period}</p>
              <div>
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
                  <h3 class="text-headline text-fg">{item.title}</h3>
                  {item.current ? (
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-success/10 px-2.5 py-0.5 text-caption font-semibold text-success">
                      <span class="size-1.5 rounded-full bg-success" aria-hidden="true" />
                      Actualmente
                    </span>
                  ) : (
                    <span class="rounded-full bg-fg/[.06] px-2.5 py-0.5 text-caption font-medium text-muted">Finalizado</span>
                  )}
                </div>
                <p class="mt-1 text-callout font-medium text-fg/80">{item.institution}</p>
                <p class="mt-2 text-callout text-muted">{item.description}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <aside data-reveal style="--reveal-i:1" class="card p-6 sm:p-8 lg:col-span-4" aria-labelledby="courses-title">
        <span class="flex size-11 items-center justify-center rounded-[0.875rem] bg-accent-fill/12 text-accent">
          <Icon name="book" class="size-[1.375rem]" />
        </span>
        <h3 id="courses-title" class="mt-5 text-headline text-fg">Cursos complementarios</h3>
        <p class="mt-1 text-callout text-muted">Platzi · Autoformación continua</p>
        <ul class="mt-5 space-y-2.5">
          {
            courses.map((c) => (
              <li class="flex items-start gap-2.5 text-callout text-fg/90">
                <Icon name="check" class="mt-1 size-4 shrink-0 text-accent" />
                {c}
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </div>
</section>
