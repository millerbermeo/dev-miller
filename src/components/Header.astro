---
import ThemeToggle from "./ThemeToggle.astro";
import Button from "./ui/Button.astro";

const navItems = [
  { label: "Sobre mí", href: "#about" },
  { label: "Proyectos", href: "#projects" },
  { label: "Experiencia", href: "#experience" },
  { label: "Stack", href: "#stack" },
  { label: "Servicios", href: "#services" },
];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50">
  <!-- Barra: material translúcido; el borde inferior aparece solo al hacer scroll -->
  <div class="header-bar material relative z-20">
    <div class="shell flex h-(--header-h) items-center justify-between gap-4">
      <a
        href="#home"
        class="press -mx-2 rounded-full px-2 py-1 text-headline font-semibold tracking-tight text-fg"
        aria-label="Miller Bermeo, ir al inicio"
      >
        Miller Bermeo
      </a>

      <nav aria-label="Principal" class="hidden md:block">
        <ul class="flex items-center gap-0.5">
          {
            navItems.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  data-nav-link={href.slice(1)}
                  class="nav-link press rounded-full px-3 py-2 text-footnote font-medium text-muted hover:text-fg"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-1.5">
        <ThemeToggle />
        <Button href="#contact" size="sm" class="hidden sm:inline-flex">Contactar</Button>

        <button
          type="button"
          id="menu-toggle"
          class="press relative inline-flex size-10 items-center justify-center rounded-full text-fg hover:bg-fg/[.07] md:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Abrir menú"
        >
          <!-- Dos líneas que se convierten en una X -->
          <span class="menu-line menu-line--top" aria-hidden="true"></span>
          <span class="menu-line menu-line--bottom" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- ══════ Menú móvil: hoja que nace bajo el botón (arriba-derecha) ══════ -->
  <div id="menu-scrim" class="menu-scrim fixed inset-0 z-0 bg-black/30 md:hidden" aria-hidden="true">
  </div>

  <div
    id="mobile-menu"
    class="mobile-menu absolute inset-x-3 top-[calc(var(--header-h)+0.5rem)] z-10 md:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Menú de navegación"
  >
    <nav
      aria-label="Principal (móvil)"
      class="material rounded-panel p-2 shadow-float"
    >
      <ul class="flex flex-col">
        {
          navItems.map(({ label, href }, i) => (
            <li class="menu-item" style={`--i:${i}`}>
              <a
                href={href}
                data-nav-link={href.slice(1)}
                class="press flex min-h-12 items-center justify-between rounded-2xl px-4 text-headline text-fg hover:bg-fg/[.06] aria-[current=true]:text-accent"
              >
                {label}
                <svg class="size-4 text-faint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="menu-item mt-2 border-t px-2 pt-3 pb-1" style={`--i:${navItems.length}`}>
        <Button href="#contact" size="lg" class="w-full">Contactar</Button>
      </div>
    </nav>
  </div>
</header>

<style>
  /* Borde por scroll: hairline + sombra suave en vez de línea dura fija */
  .header-bar {
    box-shadow: 0 1px 0 transparent;
    transition: box-shadow var(--dur-base) var(--ease-out-soft);
  }
  :global([data-scrolled]) .header-bar {
    box-shadow:
      0 1px 0 rgb(var(--line) / var(--line-alpha)),
      0 8px 24px -16px rgb(var(--shadow) / 0.25);
  }

  /* Enlace activo (scroll-spy) */
  .nav-link[aria-current="true"] {
    color: rgb(var(--fg));
    background-color: rgb(var(--fg) / 0.07);
  }

  /* Icono hamburguesa → X */
  .menu-line {
    position: absolute;
    left: 50%;
    width: 1.125rem;
    height: 1.75px;
    margin-left: -0.5625rem;
    border-radius: 9999px;
    background: currentColor;
    transition:
      translate var(--dur-base) var(--ease-spring),
      rotate var(--dur-base) var(--ease-spring);
  }
  .menu-line--top {
    translate: 0 -3.5px;
  }
  .menu-line--bottom {
    translate: 0 3.5px;
  }
  [aria-expanded="true"] .menu-line--top {
    translate: 0 0;
    rotate: 45deg;
  }
  [aria-expanded="true"] .menu-line--bottom {
    translate: 0 0;
    rotate: -45deg;
  }

  /* Hoja: escala desde el botón (arriba-derecha), entra y sale por el mismo camino */
  .mobile-menu {
    transform-origin: top right;
    opacity: 0;
    scale: 0.94;
    translate: 0 -0.5rem;
    visibility: hidden;
    transition:
      opacity var(--dur-fast) var(--ease-in-soft),
      scale var(--dur-fast) var(--ease-in-soft),
      translate var(--dur-fast) var(--ease-in-soft),
      visibility 0s linear var(--dur-fast);
  }
  .menu-scrim {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur-base) var(--ease-out-soft),
      visibility 0s linear var(--dur-base);
  }
  :global([data-menu-open]) .mobile-menu {
    opacity: 1;
    scale: 1;
    translate: 0 0;
    visibility: visible;
    transition:
      opacity var(--dur-fast) var(--ease-out-soft),
      scale 420ms var(--ease-spring),
      translate 420ms var(--ease-spring),
      visibility 0s;
  }
  :global([data-menu-open]) .menu-scrim {
    opacity: 1;
    visibility: visible;
    transition: opacity var(--dur-base) var(--ease-out-soft), visibility 0s;
  }

  /* Ítems escalonados al abrir */
  .menu-item {
    opacity: 0;
    translate: 0 -0.25rem;
    transition:
      opacity var(--dur-fast) var(--ease-out-soft),
      translate var(--dur-base) var(--ease-spring);
  }
  :global([data-menu-open]) .menu-item {
    opacity: 1;
    translate: 0 0;
    transition-delay: calc(40ms + var(--i) * 30ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    :global([data-menu-open]) .mobile-menu,
    .menu-item,
    :global([data-menu-open]) .menu-item {
      scale: none;
      translate: none;
      transition-property: opacity, visibility;
      transition-delay: 0s;
    }
  }
</style>

<script>
  const header = document.getElementById("site-header")!;
  const toggle = document.getElementById("menu-toggle") as HTMLButtonElement;
  const menu = document.getElementById("mobile-menu")!;
  const scrim = document.getElementById("menu-scrim")!;
  const root = document.documentElement;

  /* ── Borde al hacer scroll (sentinel sin listener de scroll) ── */
  const sentinel = document.createElement("div");
  sentinel.setAttribute("aria-hidden", "true");
  sentinel.style.cssText = "position:absolute;top:0;left:0;height:8px;width:1px;pointer-events:none";
  document.body.prepend(sentinel);
  new IntersectionObserver(([entry]) => {
    header.toggleAttribute("data-scrolled", !entry.isIntersecting);
  }).observe(sentinel);

  /* ── Menú móvil: foco atrapado, Escape, fondo inerte ── */
  // Todo lo visible del header (logo, tema, contactar, botón y menú) en orden
  // del DOM: el tema sigue accesible con el menú abierto.
  const focusables = () =>
    [...header.querySelectorAll<HTMLElement>("a[href], button")].filter(
      (el) => !el.hasAttribute("disabled") && el.getClientRects().length > 0 && getComputedStyle(el).visibility !== "hidden",
    );
  const background = () => document.querySelectorAll<HTMLElement>("main, footer");

  let open = false;

  const setOpen = (next: boolean, { restoreFocus = true } = {}) => {
    if (open === next) return;
    open = next;
    header.toggleAttribute("data-menu-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    root.style.overflow = open ? "hidden" : "";
    background().forEach((el) => (el.inert = open));

    if (open) {
      requestAnimationFrame(() => menu.querySelector<HTMLElement>("a[href]")?.focus());
    } else if (restoreFocus) {
      toggle.focus();
    }
  };

  toggle.addEventListener("click", () => setOpen(!open));
  scrim.addEventListener("click", () => setOpen(false));

  // Al elegir un destino se cierra sin devolver el foco (el ancla lo gestiona)
  header.querySelectorAll("a[href]").forEach((a) =>
    a.addEventListener("click", () => setOpen(false, { restoreFocus: false })),
  );

  document.addEventListener("keydown", (e) => {
    if (!open) return;
    if (e.key === "Escape") {
      e.preventDefault();
      setOpen(false);
      return;
    }
    if (e.key !== "Tab") return;
    const items = focusables();
    const first = items[0];
    const last = items[items.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // Si se pasa a escritorio con el menú abierto, se cierra
  window.matchMedia("(min-width: 48rem)").addEventListener("change", (e) => {
    if (e.matches) setOpen(false, { restoreFocus: false });
  });

  /* ── Scroll-spy: marca la sección visible ── */
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");
  // Se observan todas las secciones: las que no están en el menú (inicio,
  // contacto) limpian el estado activo.
  const sections = document.querySelectorAll<HTMLElement>("main section[id]");

  const spy = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const id = entry.target.id;
        links.forEach((l) => {
          if (l.dataset.navLink === id) l.setAttribute("aria-current", "true");
          else l.removeAttribute("aria-current");
        });
      }
    },
    { rootMargin: "-45% 0px -50% 0px" },
  );
  sections.forEach((s) => spy.observe(s));
</script>
