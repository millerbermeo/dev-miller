---
import ThemeToggle from "./ThemeToggle.astro";

const navItems = [
  { label: "Inicio", href: "#home" },
  { label: "Sobre mí", href: "#about" },
  { label: "Experiencia", href: "#experience" },
  { label: "Proyectos", href: "#projects" },
  { label: "Servicios", href: "#services" },
];
---

<header class="fixed top-0 left-0 right-0 z-50">
  <!-- ══════════════ Desktop nav pill (md+) ══════════════ -->
  <div class="hidden md:flex justify-center pt-4 px-4">
    <!--
      Borde iluminado: wrapper con gradiente de acento a 1px (p-px),
      la nav interior lleva el fondo glass. Efecto "borde que brilla".
    -->
    <div
      id="nav-pill"
      class="group relative rounded-full p-px bg-gradient-to-r from-accent/40 via-line/10 to-accent-3/40 shadow-lg shadow-black/10 transition-all duration-300"
    >
      <nav
        class="relative flex items-center gap-1 px-3 py-2 rounded-full bg-surface/70 backdrop-blur-xl"
        aria-label="Navegación principal"
      >
        <!-- Reflejo superior (highlight glass) -->
        <span
          class="pointer-events-none absolute inset-x-6 top-0 h-px bg-gradient-to-r from-transparent via-white/50 to-transparent"
          aria-hidden="true"></span>

        <a
          href="#home"
          class="font-display text-sm font-semibold text-fg px-3 mr-1 border-r border-line/10 pr-4"
        >
          Miller<span class="text-accent">.</span>
        </a>

        {
          navItems.map(({ label, href }) => (
            <a
              href={href}
              data-nav-link={href.slice(1)}
              class="nav-link relative px-3 py-1.5 text-sm text-muted hover:text-fg rounded-full transition-colors duration-200"
            >
              {label}
            </a>
          ))
        }

        <!-- CTA magnético con glow -->
        <a
          id="magnetic-contact"
          href="#contact"
          class="magnetic ml-2 px-4 py-1.5 text-sm font-semibold text-white bg-accent hover:bg-accent-2 rounded-full transition-[background-color,box-shadow,transform] duration-200 hover:shadow-lg hover:shadow-accent/40 will-change-transform"
        >
          Contactar
        </a>

        <span class="ml-1.5 pl-1.5 border-l border-line/10">
          <ThemeToggle />
        </span>
      </nav>
    </div>
  </div>

  <!-- ══════════════ Mobile header bar ══════════════ -->
  <div
    class="flex md:hidden items-center justify-between px-5 py-4 bg-bg/85 backdrop-blur-xl border-b border-line/[.06]"
  >
    <a
      href="#home"
      class="font-display text-base font-bold text-fg"
      aria-label="Ir al inicio"
    >
      Miller<span class="text-accent">.</span>
    </a>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <button
        id="mobile-menu-btn"
        class="flex items-center justify-center w-9 h-9 rounded-lg text-muted hover:text-fg hover:bg-fg/5 transition-all duration-200"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <ion-icon name="menu-outline" class="text-2xl" aria-hidden="true"></ion-icon>
      </button>
    </div>
  </div>

  <!-- ══════════════ Mobile drawer (panel deslizante) ══════════════ -->
  <!-- Overlay -->
  <div
    id="mobile-overlay"
    class="fixed inset-0 z-40 bg-black/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
    aria-hidden="true"
  >
  </div>

  <!-- Panel drawer (desde la derecha) -->
  <div
    id="mobile-menu"
    class="fixed top-0 right-0 z-50 h-[100dvh] w-[82%] max-w-xs translate-x-full transition-transform duration-300 ease-out bg-surface/95 backdrop-blur-2xl border-l border-line/10 shadow-2xl shadow-black/30 md:hidden flex flex-col"
    role="dialog"
    aria-modal="true"
    aria-label="Menú de navegación"
    aria-hidden="true"
  >
    <!-- Cabecera del panel -->
    <div class="flex items-center justify-between px-5 py-4 border-b border-line/10">
      <span class="font-display text-base font-bold text-fg">
        Miller<span class="text-accent">.</span>
      </span>
      <button
        id="mobile-close-btn"
        class="flex items-center justify-center w-9 h-9 rounded-lg text-muted hover:text-fg hover:bg-fg/5 transition-all duration-200"
        aria-label="Cerrar menú"
      >
        <ion-icon name="close-outline" class="text-2xl" aria-hidden="true"></ion-icon>
      </button>
    </div>

    <!-- Enlaces -->
    <nav class="flex flex-col gap-1 px-4 py-5" aria-label="Menú móvil">
      {
        navItems.map(({ label, href }) => (
          <a
            href={href}
            class="mobile-link px-4 py-3 text-sm font-medium text-muted hover:text-fg rounded-xl hover:bg-fg/5 transition-all duration-200"
          >
            {label}
          </a>
        ))
      }
      <a
        href="#contact"
        class="mobile-link mt-3 px-4 py-3 text-sm font-semibold text-white bg-accent hover:bg-accent-2 rounded-xl text-center transition-all duration-200"
      >
        Contactar
      </a>
    </nav>

    <!-- Pie del panel: redes -->
    <div class="mt-auto px-5 py-5 border-t border-line/10 flex items-center gap-5">
      <a
        href="https://github.com/millerbermeo"
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-focusable text-muted hover:text-fg transition-colors duration-200"
        aria-label="GitHub"
      >
        <ion-icon name="logo-github" class="text-xl" aria-hidden="true"></ion-icon>
      </a>
      <a
        href="https://www.linkedin.com/in/miller-rivera/"
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-focusable text-muted hover:text-fg transition-colors duration-200"
        aria-label="LinkedIn"
      >
        <ion-icon name="logo-linkedin" class="text-xl" aria-hidden="true"></ion-icon>
      </a>
      <a
        href="mailto:devmiller25@gmail.com"
        class="mobile-focusable text-muted hover:text-fg transition-colors duration-200"
        aria-label="Email"
      >
        <ion-icon name="mail-outline" class="text-xl" aria-hidden="true"></ion-icon>
      </a>
    </div>
  </div>
</header>

<script>
  // ═══════════════════ Mobile drawer accesible ═══════════════════
  const btn = document.getElementById("mobile-menu-btn");
  const closeBtn = document.getElementById("mobile-close-btn");
  const menu = document.getElementById("mobile-menu");
  const overlay = document.getElementById("mobile-overlay");
  let lastFocused: HTMLElement | null = null;

  function focusable(): HTMLElement[] {
    if (!menu) return [];
    return Array.from(
      menu.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled])'
      )
    );
  }

  function openMenu() {
    if (!menu || !overlay) return;
    lastFocused = document.activeElement as HTMLElement;
    menu.classList.remove("translate-x-full");
    menu.setAttribute("aria-hidden", "false");
    overlay.classList.remove("opacity-0", "pointer-events-none");
    btn?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden"; // bloquea scroll de fondo
    // Foco al primer elemento accionable del panel
    focusable()[0]?.focus();
  }

  function closeMenu() {
    if (!menu || !overlay) return;
    menu.classList.add("translate-x-full");
    menu.setAttribute("aria-hidden", "true");
    overlay.classList.add("opacity-0", "pointer-events-none");
    btn?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
    lastFocused?.focus(); // devuelve el foco al botón que abrió
  }

  btn?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);
  overlay?.addEventListener("click", closeMenu);
  document
    .querySelectorAll(".mobile-link")
    .forEach((link) => link.addEventListener("click", closeMenu));

  // Teclado: Escape cierra · Tab hace focus-trap dentro del panel
  document.addEventListener("keydown", (e) => {
    const isOpen = menu && !menu.classList.contains("translate-x-full");
    if (!isOpen) return;

    if (e.key === "Escape") {
      closeMenu();
      return;
    }
    if (e.key === "Tab") {
      const items = focusable();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  // Cierra si se pasa a desktop
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 768) closeMenu();
  });

  // ═══════════════════ Scroll-spy (nav activo) ═══════════════════
  const sections = ["home", "about", "experience", "projects", "services", "contact"];
  const navLinks = document.querySelectorAll("[data-nav-link]");

  function setActive(id: string) {
    navLinks.forEach((link) => {
      const isActive = link.getAttribute("data-nav-link") === id;
      link.classList.toggle("is-active", isActive);
    });
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) setActive(entry.target.id);
      });
    },
    { rootMargin: "-40% 0px -55% 0px", threshold: 0 }
  );
  sections.forEach((id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });

  // ═══════════════════ Botón magnético (respeta reduced-motion) ═══════════════════
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const magnetic = document.getElementById("magnetic-contact");

  if (magnetic && !reduce) {
    const strength = 0.35; // cuánto sigue al cursor
    magnetic.addEventListener("mousemove", (e) => {
      const rect = magnetic.getBoundingClientRect();
      const x = e.clientX - (rect.left + rect.width / 2);
      const y = e.clientY - (rect.top + rect.height / 2);
      magnetic.style.transform = `translate(${x * strength}px, ${y * strength}px)`;
    });
    magnetic.addEventListener("mouseleave", () => {
      magnetic.style.transform = "translate(0, 0)";
    });
  }

  // ═══════════════════ Estado "scrolled" de la píldora ═══════════════════
  const pill = document.getElementById("nav-pill");
  function onScroll() {
    if (!pill) return;
    pill.classList.toggle("nav-scrolled", window.scrollY > 24);
  }
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>

<style>
  /* Indicador de enlace activo: píldora de fondo + punto de acento */
  .nav-link.is-active {
    color: rgb(var(--text));
    background: rgb(var(--text) / 0.06);
  }
  .nav-link.is-active::after {
    content: "";
    position: absolute;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    border-radius: 9999px;
    background: rgb(var(--accent));
  }

  /* Al hacer scroll, la píldora se eleva y opaca un poco más */
  #nav-pill.nav-scrolled {
    box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.25);
  }
  #nav-pill.nav-scrolled nav {
    background: rgb(var(--surface) / 0.85);
  }

  /* Transición suave del botón magnético al soltar */
  #magnetic-contact {
    transition:
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.2s,
      box-shadow 0.2s;
  }
</style>
