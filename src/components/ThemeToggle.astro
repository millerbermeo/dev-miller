---
/**
 * Conmutador de tema (único en la página). Cross-fade con View Transitions
 * cuando el navegador lo soporta; actualiza la meta theme-color.
 */
---

<button
  type="button"
  id="theme-toggle"
  class="press relative inline-flex size-10 items-center justify-center rounded-full text-fg hover:bg-fg/[.07]"
  aria-label="Activar tema claro"
  aria-pressed="true"
  title="Cambiar tema"
>
  <!-- Luna: visible en tema oscuro -->
  <svg
    class="theme-icon theme-icon--moon absolute size-[1.15rem]"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z"></path>
  </svg>
  <!-- Sol: visible en tema claro -->
  <svg
    class="theme-icon theme-icon--sun absolute size-[1.2rem]"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
  </svg>
</button>

<style>
  .theme-icon {
    transition:
      opacity var(--dur-fast) var(--ease-out-soft),
      rotate var(--dur-base) var(--ease-spring),
      scale var(--dur-base) var(--ease-spring);
  }
  :global(.dark) .theme-icon--sun,
  :global(html:not(.dark)) .theme-icon--moon {
    opacity: 0;
    rotate: -45deg;
    scale: 0.6;
  }
</style>

<script>
  const btn = document.getElementById("theme-toggle");
  const root = document.documentElement;
  const meta = document.querySelector("meta[data-theme-color]");

  const sync = () => {
    const dark = root.classList.contains("dark");
    btn?.setAttribute("aria-pressed", String(dark));
    btn?.setAttribute("aria-label", dark ? "Activar tema claro" : "Activar tema oscuro");
    meta?.setAttribute("content", dark ? "#0a0a0c" : "#f5f5f7");
  };

  const apply = () => {
    const dark = !root.classList.contains("dark");
    root.classList.toggle("dark", dark);
    try {
      localStorage.setItem("theme", dark ? "dark" : "light");
    } catch {}
    sync();
  };

  sync();

  btn?.addEventListener("click", () => {
    // Cross-fade suave para evitar saltos bruscos de brillo
    const doc = document as Document & {
      startViewTransition?: (cb: () => void) => unknown;
    };
    if (doc.startViewTransition) doc.startViewTransition(apply);
    else apply();
  });
</script>
