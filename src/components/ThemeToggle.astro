---
// ── Toggle de tema claro/oscuro ──
// Iconos SVG inline (sin CDN, sin CLS). El icono visible cambia según el
// tema activo mediante clases `.dark` en <html> (ver Layout.astro).
// Persiste la preferencia en localStorage; el anti-flash vive en el <head>.
---

<button
  id="theme-toggle"
  type="button"
  class="group relative inline-flex h-9 w-9 items-center justify-center rounded-full border border-line/10 bg-surface/40 text-muted backdrop-blur-xl transition-colors duration-200 hover:text-fg hover:bg-surface/70"
  aria-label="Cambiar tema"
  title="Cambiar tema (claro / oscuro)"
>
  <!-- Glow sutil detrás del botón -->
  <span
    class="pointer-events-none absolute inset-0 rounded-full bg-accent/20 opacity-0 blur-md transition-opacity duration-300 group-hover:opacity-100"
    aria-hidden="true"></span>

  <!-- ☀️ Sol (visible en modo oscuro → invita a pasar a claro) -->
  <svg
    class="icon-sun h-[18px] w-[18px]"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>

  <!-- 🌙 Luna (visible en modo claro → invita a pasar a oscuro) -->
  <svg
    class="icon-moon h-[18px] w-[18px]"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<script>
  const toggle = document.getElementById("theme-toggle");

  function apply(dark: boolean) {
    document.documentElement.classList.toggle("dark", dark);
    document.documentElement.style.colorScheme = dark ? "dark" : "light";
    localStorage.setItem("theme", dark ? "dark" : "light");
    toggle?.setAttribute(
      "aria-label",
      dark ? "Activar modo claro" : "Activar modo oscuro"
    );
  }

  // Sincroniza el aria-label inicial con el estado ya aplicado por el head.
  apply(document.documentElement.classList.contains("dark"));

  toggle?.addEventListener("click", () => {
    apply(!document.documentElement.classList.contains("dark"));
  });
</script>

<style>
  /* Mostrar solo el icono correspondiente al tema activo, con crossfade */
  .icon-sun,
  .icon-moon {
    position: absolute;
    transition: opacity 0.25s ease, transform 0.35s ease;
  }
  /* Oscuro → sol visible */
  :global(.dark) .icon-sun {
    opacity: 1;
    transform: rotate(0) scale(1);
  }
  :global(.dark) .icon-moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }
  /* Claro → luna visible */
  :global(html:not(.dark)) .icon-moon {
    opacity: 1;
    transform: rotate(0) scale(1);
  }
  :global(html:not(.dark)) .icon-sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }
</style>
