---
import { projects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";
import ProjectCompact from "./ProjectCompact.astro";
import SectionHeading from "./ui/SectionHeading.astro";
import Button from "./ui/Button.astro";
import Icon from "./ui/Icon.astro";

const visible = projects.filter((p) => !p.hidden);
const featured = visible.filter((p) => p.featured);
const rest = visible.filter((p) => !p.featured);
const [lead, ...others] = featured;
---

<section id="projects" aria-labelledby="projects-title" class="section-y">
  <div class="shell">
    <SectionHeading
      id="projects-title"
      eyebrow="Proyectos"
      title="Trabajo destacado"
      description={`${featured.length} casos seleccionados. Cada uno con su problema, solución y resultado.`}
    />

    <div class="grid grid-cols-1 gap-5 sm:gap-6 lg:grid-cols-2">
      {
        lead && (
          <div data-reveal class="lg:col-span-2">
            <ProjectCard project={lead} wide eager />
          </div>
        )
      }
      {
        others.map((project, i) => {
          // Si el total es impar, el último ocupa las dos columnas para no dejar un hueco.
          const orphan = others.length % 2 === 1 && i === others.length - 1;
          return (
            <div data-reveal style={`--reveal-i:${i % 2}`} class:list={[orphan && "lg:col-span-2"]}>
              <ProjectCard project={project} wide={orphan} />
            </div>
          );
        })
      }
    </div>

    {
      rest.length > 0 && (
        <div class="mt-14 sm:mt-16">
          <h3 id="more-projects-title" class="text-title-2 text-fg">
            Más proyectos
          </h3>
          <p class="mt-1 text-callout text-muted">Otros trabajos, en resumen.</p>
          <div
            role="list"
            aria-labelledby="more-projects-title"
            class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-6"
          >
            {rest.map((project, i) => {
              // Con 5: tres arriba (2 col c/u) y dos abajo (3 col c/u); sin huecos.
              const span =
                rest.length % 3 === 2 && i >= rest.length - 2
                  ? "lg:col-span-3"
                  : rest.length % 3 === 1 && i === rest.length - 1
                    ? "lg:col-span-6"
                    : "lg:col-span-2";
              return (
                <div role="listitem" data-reveal style={`--reveal-i:${i % 3}`} class:list={[span]}>
                  <ProjectCompact project={project} />
                </div>
              );
            })}
          </div>
        </div>
      )
    }

    <div class="mt-10 flex justify-center">
      <Button href="https://github.com/millerbermeo" variant="ghost" external class="text-muted hover:text-fg">
        <Icon name="github" class="size-4" />
        Ver más en GitHub
        <Icon name="arrow-up-right" class="size-3.5" />
      </Button>
    </div>
  </div>
</section>

<script>
  // Selector de capturas: cambia la imagen al instante cuando ya está decodificada.
  document.querySelectorAll<HTMLButtonElement>("[data-thumb]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const card = btn.closest("[data-project-card]");
      const img = card?.querySelector<HTMLImageElement>("[data-main-image]");
      const { src, srcset } = btn.dataset;
      if (!card || !img || !src || btn.getAttribute("aria-pressed") === "true") return;

      card.querySelectorAll("[data-thumb]").forEach((t) => t.setAttribute("aria-pressed", "false"));
      btn.setAttribute("aria-pressed", "true");

      img.setAttribute("data-swapping", "");
      const next = new Image();
      next.sizes = img.sizes;
      if (srcset) next.srcset = srcset;
      next.src = src;
      try {
        await next.decode();
      } catch {}
      if (srcset) img.srcset = srcset;
      img.src = src;
      img.removeAttribute("data-swapping");
    });
  });
</script>
