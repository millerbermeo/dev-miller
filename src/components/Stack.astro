---
import SectionHeading from "./ui/SectionHeading.astro";
import HtmlIcon from "./icons/HtmlIcon.astro";
import CssIcon from "./icons/CssIcon.astro";
import JavascriptIcon from "./icons/JavascriptIcon.astro";
import Tailwindicon from "./icons/Tailwindicon.astro";
import ReactIcon from "./icons/ReactIcon.astro";
import AstroIcon from "./icons/AstroIcon.astro";
import NextjsIcon from "./icons/NextjsIcon.astro";
import NodeIcon from "./icons/NodeIcon.astro";
import MysqlIcon from "./icons/MysqlIcon.astro";
import DockerIcon from "./icons/DockerIcon.astro";
import GitIcon from "./icons/GitIcon.astro";
import GithubIcon from "./icons/GithubIcon.astro";
import LInuxIcon from "./icons/LInuxIcon.astro";
import CodexIcon from "./icons/CodexIcon.astro";
import ClaudeCodeIcon from "./icons/ClaudeCodeIcon.astro";
import OpenCodeIcon from "./icons/OpenCodeIcon.astro";
import OpenClawIcon from "./icons/OpenClawIcon.astro";

// Mapa de iconos de marca (en vez de una cadena de condicionales).
const icons = {
  html: HtmlIcon,
  css: CssIcon,
  js: JavascriptIcon,
  tailwind: Tailwindicon,
  react: ReactIcon,
  nextjs: NextjsIcon,
  astro: AstroIcon,
  node: NodeIcon,
  mysql: MysqlIcon,
  docker: DockerIcon,
  linux: LInuxIcon,
  git: GitIcon,
  github: GithubIcon,
  codex: CodexIcon,
  "claude-code": ClaudeCodeIcon,
  opencode: OpenCodeIcon,
  openclaw: OpenClawIcon,
} as const;

// Logos monocromos blancos: en tema claro se pintan con el color de texto.
const mono = new Set(["github", "astro"]);

type Item = { name: string; icon?: keyof typeof icons; color?: string; letter?: string };

const categories: { label: string; items: Item[] }[] = [
  {
    label: "Lenguajes",
    items: [
      { name: "Python", color: "#3776AB", letter: "Py" },
      { name: "JavaScript", icon: "js" },
      { name: "TypeScript", color: "#3178C6", letter: "TS" },
      { name: "SQL", color: "#F29111", letter: "SQL" },
    ],
  },
  {
    label: "Frontend",
    items: [
      { name: "HTML", icon: "html" },
      { name: "CSS", icon: "css" },
      { name: "React", icon: "react" },
      { name: "Next.js", icon: "nextjs" },
      { name: "Astro", icon: "astro" },
    ],
  },
  {
    label: "Librerías UI/UX",
    items: [
      { name: "Tailwind CSS", icon: "tailwind" },
      { name: "Bootstrap", color: "#7952B3", letter: "Bs" },
      { name: "shadcn/ui", color: "#94A3B8", letter: "sh" },
      { name: "HeroUI", color: "#006FEE", letter: "Hu" },
      { name: "DaisyUI", color: "#FF9903", letter: "Dy" },
    ],
  },
  {
    label: "Mobile",
    items: [
      { name: "React Native", color: "#61DAFB", letter: "RN" },
      { name: "Expo", color: "#4630EB", letter: "Ex" },
      { name: "EAS Build", color: "#3B82F6", letter: "EAS" },
      { name: "Google Play", color: "#01875F", letter: "GP" },
      { name: "App Store", color: "#0D96F6", letter: "AS" },
    ],
  },
  {
    label: "Backend",
    items: [
      { name: "Node.js", icon: "node" },
      { name: "NestJS", color: "#E0234E", letter: "Ne" },
      { name: "FastAPI", color: "#009688", letter: "FA" },
      { name: "Flask", color: "#94A3B8", letter: "Fl" },
    ],
  },
  {
    label: "Bases de datos",
    items: [
      { name: "PostgreSQL", color: "#336791", letter: "PG" },
      { name: "MySQL", icon: "mysql" },
    ],
  },
  {
    label: "DevOps & Cloud",
    items: [
      { name: "Docker", icon: "docker" },
      { name: "Linux", icon: "linux" },
      { name: "Ubuntu Desktop", color: "#E95420", letter: "Ub" },
      { name: "Ubuntu Server", color: "#E95420", letter: "Us" },
      { name: "AWS", color: "#FF9900", letter: "AWS" },
    ],
  },
  {
    label: "Integraciones & IA",
    items: [
      { name: "OpenAI API", color: "#74AA9C", letter: "AI" },
      { name: "Claude API", color: "#D4A574", letter: "Cl" },
      { name: "WhatsApp API", color: "#25D366", letter: "WA" },
    ],
  },
  {
    label: "Herramientas",
    items: [
      { name: "Git", icon: "git" },
      { name: "GitHub", icon: "github" },
      { name: "REST APIs", color: "#6366f1", letter: "API" },
      { name: "Principios SOLID", color: "#8B5CF6", letter: "S" },
    ],
  },
  {
    label: "Copilotos IA",
    items: [
      { name: "Claude Code", icon: "claude-code" },
      { name: "OpenCode", icon: "opencode" },
      { name: "OpenClaw", icon: "openclaw" },
      { name: "Codex", icon: "codex" },
      { name: "Agentes IA", color: "#A78BFA", letter: "AG" },
      { name: "Subagentes", color: "#38BDF8", letter: "SA" },
      { name: "Skills", color: "#34D399", letter: "SK" },
      { name: "MCP", color: "#F472B6", letter: "MCP" },
    ],
  },
];
---

<section id="stack" aria-labelledby="stack-title" class="section-y">
  <div class="shell">
    <SectionHeading
      id="stack-title"
      eyebrow="Tecnologías"
      title="Stack tecnológico"
      description="Lo que uso a diario: backend, frontend, datos, infraestructura e integraciones con IA."
    />

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((cat, i) => (
          <div data-reveal style={`--reveal-i:${i % 3}`} class:list={["card p-5 sm:p-6", i === categories.length - 1 && "lg:col-span-3"]}>
            <h3 class="text-footnote font-semibold text-muted">{cat.label}</h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {cat.items.map((item) => {
                const Logo = item.icon ? icons[item.icon] : null;
                return (
                  <li class="chip inline-flex min-h-9 items-center gap-2 rounded-chip bg-fg/[.045] py-1.5 pr-3 pl-2 text-footnote font-medium text-fg">
                    {Logo ? (
                      <span
                        class:list={["logo flex size-5 shrink-0 items-center justify-center", item.icon && mono.has(item.icon) && "logo-mono"]}
                        aria-hidden="true"
                      >
                        <Logo />
                      </span>
                    ) : (
                      <span
                        class="letter flex h-5 min-w-5 shrink-0 items-center justify-center rounded-md px-0.5 text-[0.5625rem] font-bold"
                        style={`--c:${item.color}`}
                        aria-hidden="true"
                      >
                        {item.letter}
                      </span>
                    )}
                    {item.name}
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .logo :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .chip {
    transition: background-color var(--dur-fast) var(--ease-out-soft);
  }
  .chip:hover {
    background-color: rgb(var(--fg) / 0.08);
  }

  /* Insignias de letra: tinte del color de marca, legible en ambos temas */
  .letter {
    color: color-mix(in oklab, var(--c) 70%, rgb(var(--fg)));
    background-color: color-mix(in oklab, var(--c) 18%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--c) 30%, transparent);
  }

  /* Logos blancos (GitHub, Astro) invisibles sobre fondo claro → color de texto */
  :global(html:not(.dark)) .logo-mono :global([fill="#fff"]) {
    fill: rgb(var(--fg));
  }
</style>
