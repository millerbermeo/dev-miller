---
import SectionHeading from "./ui/SectionHeading.astro";

const stats = [
  { value: 4, suffix: "+", label: "Años de experiencia" },
  { value: 3, suffix: "+", label: "Años en producción" },
  { value: 18, suffix: "+", label: "Proyectos entregados" },
];
---

<section id="about" aria-labelledby="about-title" class="section-y">
  <div class="shell">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <SectionHeading
          id="about-title"
          eyebrow="Sobre mí"
          title="Desarrollador enfocado en impacto real, no solo en código"
          class="mb-8! sm:mb-10!"
        />
        <div data-reveal class="max-w-[62ch] space-y-5 text-lead text-muted">
          <p>
            Construyo sistemas críticos de negocio: plataformas SaaS, puntos de
            venta y soluciones con IA integrada, con años de proyectos propios
            afinando el oficio.
          </p>
          <p>
            Me especializo en <strong class="font-semibold text-fg">backend y desarrollo fullstack</strong>,
            con foco en automatización con IA, integración de APIs,
            arquitecturas orientadas a operaciones y apps móviles con React Native.
          </p>
          <p>
            Entiendo el negocio detrás de cada solución: identifico el problema,
            diseño la arquitectura y entrego resultados.
          </p>
        </div>
      </div>

      <!-- Cifras: tiles con count-up (tabular-nums para que no salten) -->
      <dl class="grid grid-cols-3 gap-3 self-end sm:gap-4 lg:col-span-5 lg:grid-cols-1">
        {
          stats.map((s, i) => (
            <div
              data-reveal
              style={`--reveal-i:${i}`}
              class="card flex flex-col-reverse justify-end gap-1 p-4 sm:p-6 lg:flex-row-reverse lg:items-baseline lg:justify-between lg:p-7"
            >
              <dt class="text-footnote leading-snug text-muted sm:text-callout">{s.label}</dt>
              <dd
                class="text-title-1 text-fg tabular-nums"
                data-count={s.value}
                data-suffix={s.suffix}
              >
                {s.value}{s.suffix}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
