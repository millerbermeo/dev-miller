---
import type { Project } from "../data/projects";
import Icon from "./ui/Icon.astro";
import Button from "./ui/Button.astro";
import CodexIcon from "./icons/CodexIcon.astro";
import ClaudeCodeIcon from "./icons/ClaudeCodeIcon.astro";
import OpenCodeIcon from "./icons/OpenCodeIcon.astro";
import OpenClawIcon from "./icons/OpenClawIcon.astro";
import {
  findProjectImage,
  responsiveImage,
  thumbnail,
  type ResponsiveImage,
} from "../lib/projectImages";

interface Props {
  project: Project;
  /** Tarjeta horizontal a ancho completo (proyecto principal). */
  wide?: boolean;
  /** Prioridad de carga de la imagen principal. */
  eager?: boolean;
}

const { project, wide = false, eager = false } = Astro.props;

const copilotIcons = {
  Codex: CodexIcon,
  "Claude Code": ClaudeCodeIcon,
  OpenCode: OpenCodeIcon,
  OpenClaw: OpenClawIcon,
};

// Tinte del placeholder cuando aún no hay captura (sutil, no compite con el acento).
const tintMap: Record<Project["accent"], string> = {
  indigo: "99 102 241",
  emerald: "16 185 129",
  violet: "139 92 246",
  orange: "249 115 22",
  cyan: "6 182 212",
  green: "34 197 94",
  blue: "59 130 246",
  amber: "245 158 11",
};

const isPlayStore = project.deploy?.includes("play.google.com") ?? false;
const shortTitle = project.title.split(" — ")[0];

// Capturas disponibles (las rutas inexistentes se ignoran → placeholder)
const paths = project.images?.length ? project.images : [project.image];
const metas = paths.map(findProjectImage).filter((m) => m !== undefined);
const shots: (ResponsiveImage & { thumb: string })[] = await Promise.all(
  metas.map(async (m) => ({ ...(await responsiveImage(m)), thumb: await thumbnail(m) })),
);
const main = shots[0];
// Capturas verticales (apps móviles): se muestran completas sobre fondo tintado, sin recortar.
const portrait = !!main && main.height > main.width;
const sizes = wide
  ? "(min-width: 1024px) 36rem, 100vw"
  : "(min-width: 1024px) 34rem, (min-width: 640px) 90vw, 100vw";
---

<article
  data-project-card
  aria-labelledby={`project-${project.appId ?? paths[0].replace(/\W+/g, "-")}`}
  class:list={[
    "card card-lift group/card flex h-full flex-col overflow-hidden",
    wide && "lg:grid lg:grid-cols-2 lg:items-stretch",
  ]}
  style={`--tint:${tintMap[project.accent]}`}
>
  <!-- ── Visual ── -->
  <div class:list={["p-2 pb-0", wide && "lg:p-2 lg:pr-0"]}>
    <div
      class:list={[
        "relative overflow-hidden rounded-[calc(var(--radius-card)-0.5rem)] bg-surface-2",
        portrait
          ? "portrait-shot placeholder h-[28rem] sm:h-[32rem]"
          : wide ? "aspect-[4/3] lg:aspect-auto lg:h-full lg:min-h-[26rem]" : "aspect-[2/1]",
        wide && main && !portrait && "wide-shot placeholder",
      ]}
    >
      {
        main ? (
          <img
            data-main-image
            src={main.src}
            srcset={main.srcset}
            sizes={sizes}
            width={main.width}
            height={main.height}
            alt={`Captura de ${shortTitle}`}
            loading={eager ? "eager" : "lazy"}
            decoding="async"
            class:list={["main-image size-full", portrait ? "object-contain" : "object-cover object-top"]}
          />
        ) : isPlayStore ? (
          /* App móvil sin capturas: maqueta de teléfono abstracta */
          <div class="placeholder flex size-full items-center justify-center" aria-hidden="true">
            <div class="phone relative flex aspect-[9/19] h-[78%] flex-col items-center justify-center gap-3 rounded-[2rem] bg-surface p-4 shadow-float">
              <span class="absolute top-2.5 h-1.5 w-12 rounded-full bg-fg/10" />
              <span class="flex size-14 items-center justify-center rounded-2xl bg-[rgb(var(--tint))] text-white shadow-card">
                <Icon name="phone" class="size-7" />
              </span>
              <span class="text-center text-footnote font-semibold text-fg">Domicilios</span>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-fg/[.06] px-2.5 py-1 text-caption font-medium text-muted">
                <Icon name="google-play" class="size-3" />
                Google Play
              </span>
            </div>
          </div>
        ) : (
          <div class="placeholder flex size-full items-center justify-center" aria-hidden="true">
            <span class="text-[5rem] leading-none font-bold tracking-tighter text-[rgb(var(--tint)/.45)] select-none">
              {shortTitle.charAt(0)}
            </span>
          </div>
        )
      }

      {
        shots.length > 1 && (
          <div
            class="material absolute inset-x-2 bottom-2 flex gap-1.5 overflow-x-auto rounded-2xl p-1.5 [scrollbar-width:none]"
            role="group"
            aria-label={`Capturas de ${shortTitle}`}
          >
            {shots.map((s, i) => (
              <button
                type="button"
                data-thumb
                data-src={s.src}
                data-srcset={s.srcset}
                aria-pressed={i === 0 ? "true" : "false"}
                aria-label={`Ver captura ${i + 1} de ${shots.length}`}
                class:list={["thumb press relative shrink-0 overflow-hidden rounded-lg", portrait ? "h-14 w-7" : "h-9 w-16"]}
              >
                <img src={s.thumb} alt="" width="64" height="36" loading="lazy" decoding="async" class="size-full object-cover object-top" />
              </button>
            ))}
          </div>
        )
      }
    </div>
  </div>

  <!-- ── Contenido ── -->
  <div class:list={["flex flex-1 flex-col p-6 sm:p-7", wide && "lg:p-10"]}>
    <p class="text-footnote font-semibold text-accent">{project.label}</p>
    <h3
      id={`project-${project.appId ?? paths[0].replace(/\W+/g, "-")}`}
      class:list={["mt-2 text-fg", wide ? "text-title-2" : "text-headline sm:text-[1.3125rem] sm:leading-tight"]}
    >
      {project.title}
    </h3>

    <dl class="mt-5 space-y-4 text-callout">
      <div>
        <dt class="text-footnote font-semibold text-fg">Problema</dt>
        <dd class="mt-1 text-muted">{project.problem}</dd>
      </div>
      <div>
        <dt class="text-footnote font-semibold text-fg">Solución</dt>
        <dd class="mt-1 text-muted">{project.solution}</dd>
      </div>
      <div>
        <dt class="text-footnote font-semibold text-fg">Resultado</dt>
        <dd class="mt-1 flex gap-2 text-fg/90">
          <Icon name="check" class="mt-[0.2rem] size-4 shrink-0 text-success" />
          <span>{project.result}</span>
        </dd>
      </div>
    </dl>

    <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Tecnologías">
      {
        project.stack.map((t) => (
          <li class="rounded-chip bg-fg/[.05] px-2.5 py-1 text-caption font-medium text-muted">{t}</li>
        ))
      }
    </ul>

    {
      project.copilots.length > 0 && (
        <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-caption text-faint">
          <span>Desarrollado con</span>
          {project.copilots.map((name) => {
            const C = copilotIcons[name];
            return (
              <span class="inline-flex items-center gap-1 text-muted">
                <span class="size-3.5 [&_svg]:size-full" aria-hidden="true"><C /></span>
                {name}
              </span>
            );
          })}
        </p>
      )
    }

    <!-- Acciones: siempre al fondo de la tarjeta -->
    {
      (project.deploy || project.github) && (
        <div class="mt-auto flex flex-wrap gap-2 pt-7">
          {project.deploy && (
            <Button href={project.deploy} variant={wide ? "primary" : "secondary"} size="sm" external>
              <Icon name={isPlayStore ? "google-play" : "arrow-up-right"} class="size-3.5" />
              {isPlayStore ? "Ver en Google Play" : "Ver demo"}
              <span class="sr-only">de {shortTitle}</span>
            </Button>
          )}
          {project.github && (
            <Button href={project.github} variant="ghost" size="sm" external class="text-muted hover:text-fg">
              <Icon name="github" class="size-3.5" />
              Código
              <span class="sr-only">de {shortTitle}</span>
            </Button>
          )}
        </div>
      )
    }
  </div>
</article>

<style>
  .placeholder {
    background:
      radial-gradient(80% 90% at 30% 20%, rgb(var(--tint) / 0.22), transparent 70%),
      radial-gradient(70% 80% at 85% 90%, rgb(var(--tint) / 0.14), transparent 70%),
      rgb(var(--surface-2));
  }

  .main-image {
    transition:
      opacity var(--dur-fast) var(--ease-out-soft),
      scale 700ms var(--ease-spring);
  }
  @media (hover: hover) {
    .group\/card:hover .main-image {
      scale: 1.02;
    }
  }
  /* Tarjeta ancha con captura real: las capturas son ~2:1, así que en lugar de
     recortarlas a un formato vertical se muestran completas, como una ventana
     flotando sobre el fondo tintado del proyecto. */
  .wide-shot {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem 1.25rem 4rem;
  }
  .wide-shot .main-image {
    height: auto;
    border-radius: 0.75rem;
    object-fit: contain;
    box-shadow: var(--shadow-float);
  }
  @media (min-width: 64rem) {
    .wide-shot {
      padding: 2rem 2rem 4.5rem;
    }
  }

  /* Capturas verticales: teléfono completo centrado, con hueco abajo para las miniaturas. */
  .portrait-shot {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 1rem 5rem;
  }
  .portrait-shot .main-image {
    width: auto;
    max-width: 100%;
    border-radius: 1.25rem;
    box-shadow: var(--shadow-float);
  }

  .main-image[data-swapping] {
    opacity: 0.35;
  }

  .thumb {
    opacity: 0.6;
    box-shadow: 0 0 0 1px rgb(var(--line) / var(--line-alpha));
  }
  .thumb:hover {
    opacity: 0.9;
  }
  .thumb[aria-pressed="true"] {
    opacity: 1;
    box-shadow: 0 0 0 2px rgb(var(--accent));
  }

  @media (prefers-reduced-motion: reduce) {
    .group\/card:hover .main-image {
      scale: none;
    }
  }
</style>
