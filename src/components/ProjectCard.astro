---
import CodexIcon from "./icons/CodexIcon.astro";
import ClaudeCodeIcon from "./icons/ClaudeCodeIcon.astro";
import OpenCodeIcon from "./icons/OpenCodeIcon.astro";
import OpenClawIcon from "./icons/OpenClawIcon.astro";

interface Props {
  project: any;
  /** Marca de animación GSAP. Omitir en cards que aparecen tras un click. */
  animate?: boolean;
}

const { project, animate = true } = Astro.props;

// Enlace de deploy: si apunta a Google Play se muestra como "Play Store".
const isPlayStore =
  typeof project.deploy === "string" &&
  project.deploy.includes("play.google.com");
const deployLabel = isPlayStore ? "Play Store" : "Deploy";
const deployIcon = isPlayStore ? "logo-google-playstore" : "globe-outline";

const copilotIcons: Record<string, any> = {
  Codex: CodexIcon,
  "Claude Code": ClaudeCodeIcon,
  OpenCode: OpenCodeIcon,
  OpenClaw: OpenClawIcon,
};

const accentMap: Record<string, string> = {
  indigo: "border-indigo-500/30 text-indigo-400 bg-indigo-500/10",
  emerald: "border-emerald-500/30 text-emerald-400 bg-emerald-500/10",
  violet: "border-violet-500/30 text-violet-400 bg-violet-500/10",
  orange: "border-orange-500/30 text-orange-400 bg-orange-500/10",
  cyan: "border-cyan-500/30 text-cyan-400 bg-cyan-500/10",
  green: "border-green-500/30 text-green-400 bg-green-500/10",
  blue: "border-blue-500/30 text-blue-400 bg-blue-500/10",
  amber: "border-amber-500/30 text-amber-400 bg-amber-500/10",
};

const placeholderMap: Record<string, string> = {
  indigo: "from-indigo-500/40 to-violet-600/30",
  emerald: "from-emerald-500/40 to-cyan-600/30",
  violet: "from-violet-500/40 to-fuchsia-600/30",
  orange: "from-orange-500/40 to-amber-600/30",
  cyan: "from-cyan-500/40 to-blue-600/30",
  green: "from-green-500/40 to-emerald-600/30",
  blue: "from-blue-500/40 to-sky-600/30",
  amber: "from-amber-500/40 to-orange-600/30",
};
---

<article
  data-project-card
  data-anim={animate ? "project-card" : undefined}
  data-spotlight
  class="group h-full bg-fg/[.03] border border-line/10 rounded-2xl overflow-hidden hover:border-line/20 hover:-translate-y-1 transition-all duration-300"
>
  <div class="flex flex-col h-full">
    <!-- Image (con placeholder de gradiente como fallback si no existe) -->
    <div
      class={`relative w-full h-32 sm:h-36 overflow-hidden bg-linear-to-br ${placeholderMap[project.accent]}`}
    >
      <div
        class="absolute inset-0 flex items-center justify-center"
        aria-hidden="true"
      >
        <span class="font-display text-6xl font-bold text-white/25 select-none">
          {project.title.charAt(0)}
        </span>
      </div>
      <img
        data-main-image
        src={`/${project.images?.[0] ?? project.image}`}
        alt={project.title}
        width="800"
        height="450"
        loading="lazy"
        decoding="async"
        onerror="this.style.display='none'"
        class="relative w-full h-full object-contain transition-opacity duration-300 opacity-90 group-hover:opacity-100"
      />
    </div>

    <!-- Thumbnails (solo si el proyecto tiene galería de imágenes) -->
    {
      project.images && project.images.length > 1 && (
        <div class="flex items-center gap-1.5 p-2 bg-fg/[.02] border-b border-line/[.08] overflow-x-auto">
          {project.images.map((img: string, i: number) => (
            <button
              type="button"
              data-thumb={`/${img}`}
              aria-label={`Ver captura ${i + 1}`}
              class={`shrink-0 w-12 h-8 sm:w-14 sm:h-9 rounded-md overflow-hidden border-2 transition-all duration-200 ${i === 0 ? "border-accent ring-1 ring-accent" : "border-line/10 hover:border-line/30"}`}
            >
              <img
                src={`/${img}`}
                alt=""
                width="80"
                height="48"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover object-top"
              />
            </button>
          ))}
        </div>
      )
    }

    <!-- Content -->
    <div class="flex-1 flex flex-col p-4 sm:p-5 min-w-0">
      <span
        class={`inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-full border mb-2.5 self-start ${accentMap[project.accent]}`}
      >
        {project.label}
      </span>

      <h3 class="text-[15px] sm:text-base font-bold text-fg text-pretty leading-snug mb-2.5 sm:mb-3">
        {project.title}
      </h3>

      <div class="space-y-2 mb-4">
        <div class="flex flex-col sm:flex-row sm:gap-2 text-sm">
          <span
            class="text-faint font-medium sm:shrink-0 sm:w-20 mb-0.5 sm:mb-0"
          >
            Problema
          </span>
          <span class="text-muted text-xs sm:text-sm line-clamp-3"
            >{project.problem}</span
          >
        </div>
        <div class="flex flex-col sm:flex-row sm:gap-2 text-sm">
          <span
            class="text-faint font-medium sm:shrink-0 sm:w-20 mb-0.5 sm:mb-0"
          >
            Solución
          </span>
          <span class="text-muted text-xs sm:text-sm line-clamp-3"
            >{project.solution}</span
          >
        </div>
        <div class="flex flex-col sm:flex-row sm:gap-2 text-sm">
          <span
            class="text-faint font-medium sm:shrink-0 sm:w-20 mb-0.5 sm:mb-0"
          >
            Resultado
          </span>
          <span class="text-fg/80 font-medium text-xs sm:text-sm line-clamp-2">
            {project.result}
          </span>
        </div>
      </div>

      <!-- Footer -->
      <div class="mt-auto space-y-3 pt-3 sm:pt-4 border-t border-line/[.08]">
        <div class="flex flex-wrap gap-1.5">
          {
            project.stack.map((tech: string) => (
              <span class="px-2 py-0.5 text-xs text-muted bg-fg/[.03] border border-line/10 rounded-md">
                {tech}
              </span>
            ))
          }
        </div>
        {
          project.copilots && project.copilots.length > 0 && (
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-xs text-faint font-medium">Copilotos IA:</span>
              {project.copilots.map((copilot: string) => {
                const IconComponent = copilotIcons[copilot];
                return (
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs text-cyan-400 bg-cyan-500/10 border border-cyan-500/20 rounded-md">
                    {IconComponent && <IconComponent />}
                    {copilot}
                  </span>
                );
              })}
            </div>
          )
        }
        <div class="flex items-center justify-between flex-wrap gap-3 pt-2">
          <div class="flex items-center gap-3">
            {
              project.deploy && (
                <a
                  href={project.deploy}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1.5 text-xs font-medium text-muted hover:text-fg transition-colors duration-200 shrink-0"
                >
                  <ion-icon name={deployIcon} class="text-sm" />
                  {deployLabel}
                </a>
              )
            }
            {
              project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1.5 text-xs font-medium text-muted hover:text-fg transition-colors duration-200 shrink-0"
                >
                  <ion-icon name="logo-github" class="text-sm" />
                  GitHub
                </a>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</article>
