---
import SectionHeading from "./ui/SectionHeading.astro";
import Icon from "./ui/Icon.astro";
import Button from "./ui/Button.astro";

const services = [
  {
    icon: "sparkles",
    title: "Automatización con IA",
    desc: "Integro modelos de lenguaje (OpenAI, Claude) en tus procesos operativos para automatizar tareas repetitivas, clasificar información y generar respuestas inteligentes.",
    tags: ["OpenAI", "Claude API", "Agentes IA", "n8n"],
  },
  {
    icon: "server",
    title: "Desarrollo Backend & APIs",
    desc: "Diseño y construyo APIs RESTful robustas, escalables y bien documentadas con Node.js/NestJS o Python/FastAPI. Arquitectura limpia, SOLID y orientada a producción.",
    tags: ["Node.js", "NestJS", "FastAPI", "PostgreSQL", "Docker"],
  },
  {
    icon: "chat",
    title: "Chatbots & Integraciones",
    desc: "Desarrollo chatbots funcionales para WhatsApp Business API con flujos conversacionales, lógica de negocio personalizada y conexión a tus sistemas existentes.",
    tags: ["WhatsApp API", "Chatbot", "Node.js", "Webhooks"],
  },
  {
    icon: "layers",
    title: "Plataformas SaaS & Fullstack",
    desc: "Desarrollo plataformas web completas multi-tenant: desde la arquitectura hasta el despliegue. POS, dashboards administrativos, sistemas de gestión y más.",
    tags: ["React", "Next.js", "NestJS", "PostgreSQL", "AWS"],
  },
  {
    icon: "phone",
    title: "Apps Móviles con React Native",
    desc: "Desarrollo apps Android (y iOS) con React Native + Expo: del prototipo a producción en Google Play, con builds y entregas gestionadas con EAS.",
    tags: ["React Native", "Expo", "EAS", "Google Play", "TypeScript"],
  },
] as const;

// Bento: 2 grandes arriba + 3 en la fila inferior (lg). 2 columnas en tablet.
const spans = [
  "lg:col-span-3",
  "lg:col-span-3",
  "lg:col-span-2",
  "lg:col-span-2",
  "sm:col-span-2 lg:col-span-2",
];
---

<section id="services" aria-labelledby="services-title" class="section-y">
  <div class="shell">
    <SectionHeading
      id="services-title"
      eyebrow="Servicios"
      title="¿En qué puedo ayudarte?"
      description="Cinco frentes en los que puedo entrar a tu proyecto, solo o integrado a tu equipo."
    />

    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
      {
        services.map((s, i) => (
          <li data-reveal style={`--reveal-i:${i % 3}`} class={spans[i]}>
            <article class="card card-lift group/svc flex h-full flex-col p-6 sm:p-7">
              <span class="svc-icon flex size-11 items-center justify-center rounded-[0.875rem] bg-accent-fill/12 text-accent">
                <Icon name={s.icon} class="size-[1.375rem]" />
              </span>
              <h3 class="mt-5 text-headline text-fg">{s.title}</h3>
              <p class="mt-2 text-callout text-muted">{s.desc}</p>
              <ul class="mt-auto flex flex-wrap gap-1.5 pt-6" aria-label="Herramientas">
                {s.tags.map((t) => (
                  <li class="rounded-chip bg-fg/[.05] px-2.5 py-1 text-caption font-medium text-muted">{t}</li>
                ))}
              </ul>
            </article>
          </li>
        ))
      }
    </ul>

    <div data-reveal class="mt-10 flex justify-center">
      <Button href="#contact" variant="secondary">
        Cuéntame qué necesitas
        <Icon name="arrow-right" class="size-4 transition-transform duration-200 group-hover/btn:translate-x-0.5" />
      </Button>
    </div>
  </div>
</section>

<style>
  .svc-icon {
    transition: scale var(--dur-base) var(--ease-spring);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global(.group\/svc:hover) .svc-icon {
      scale: 1.08;
    }
  }
</style>
