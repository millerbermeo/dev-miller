 * cero CLS). Trazo estilo Lucide (1.75) para UI; relleno para marcas.
 * Decorativos por defecto (aria-hidden); pasa `label` si transmiten
 * información por sí solos.
 */
interface Props {
  name: keyof typeof strokes | keyof typeof fills;
  class?: string;
  label?: string;
}

const strokes = {
