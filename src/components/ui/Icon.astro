  "google-play":
    '<path d="M22.02 10.5 18.6 8.53l-3.22 3.22 3.22 3.22 3.44-1.98a1.4 1.4 0 0 0-.02-2.49M2.12 0 13.6 11.75l2.96-2.96L3.68.15A1.6 1.6 0 0 0 2.12 0M1.3.85c-.18.24-.3.56-.3.94v20.42c0 .38.12.7.3.94L12.8 11.75zm.82 23.15a1.6 1.6 0 0 0 1.56-.15l12.88-7.4-2.96-2.96z"/>',
};

const { name, class: className = "size-5", label } = Astro.props;
const isFill = name in fills;
const body = isFill
  ? fills[name as keyof typeof fills]
  : strokes[name as keyof typeof strokes];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class={className}
  fill={isFill ? "currentColor" : "none"}
  stroke={isFill ? undefined : "currentColor"}
  stroke-width={isFill ? undefined : 1.75}
  stroke-linecap={isFill ? undefined : "round"}
  stroke-linejoin={isFill ? undefined : "round"}
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={label}
  focusable="false"
  set:html={body}
/>
