---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
import Experience from "../components/Experience.astro";
import Stack from "../components/Stack.astro";
import Services from "../components/Services.astro";
import Education from "../components/Education.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Miller Bermeo — Desarrollador Fullstack & IA | Portafolio"
  description="Desarrollador Fullstack con 4 años de experiencia: plataformas SaaS, sistemas POS, apps móviles con React Native, chatbots y automatización con IA."
>
  <main id="main" tabindex="-1">
    <Hero />
    <About />
    <Projects />
    <Experience />
    <Stack />
    <Services />
    <Education />
    <Contact />
  </main>
  <Footer />
</Layout>
