---
import Header from "../components/Header.astro";
import CursorGlow from "../components/CursorGlow.astro";
import "../styles/global.css";
import "@fontsource-variable/onest";
// URL final (con hash) de la fuente latina para precargarla y evitar FOUT/CLS.
import onestWoff2 from "@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  /** Ruta absoluta (desde /public) de la imagen social 1200×630. */
  image?: string;
  imageAlt?: string;
}

const {
  title = "Miller Bermeo — Desarrollador Fullstack & IA",
  description = "Desarrollador Fullstack con 4 años de experiencia (3 en producción): sistemas POS, plataformas SaaS, apps móviles con React Native, chatbots con IA y automatizaciones de negocio.",
  image = "/og-image.png",
  imageAlt = "Miller Bermeo — Desarrollador Fullstack & IA",
} = Astro.props;

const site = Astro.site ?? new URL("https://millerbermeo.com");
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;

// Datos estructurados: Person + WebSite enlazados por @id.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${site.origin}/#person`,
      name: "Miller Bermeo",
      jobTitle: "Desarrollador Fullstack & IA",
      url: site.origin,
      email: "mailto:devmiller25@gmail.com",
      image: new URL("/apple-touch-icon.png", site).href,
      worksFor: { "@type": "Organization", name: "Desarrollo G" },
      knowsAbout: [
        "TypeScript", "JavaScript", "SQL", "Node.js", "NestJS", "Python",
        "FastAPI", "React", "Next.js", "Bootstrap", "shadcn/ui", "HeroUI", "DaisyUI", "React Native", "Expo", "PostgreSQL",
        "MySQL", "Docker", "Linux", "Ubuntu Server", "AWS",
        "OpenAI API", "Claude API", "Agentes de IA", "Subagentes", "Skills", "MCP",
      ],
      sameAs: [
        "https://github.com/millerbermeo",
        "https://www.linkedin.com/in/miller-rivera/",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${site.origin}/#website`,
      url: site.origin,
      name: "Miller Bermeo — Portafolio",
      inLanguage: "es",
      publisher: { "@id": `${site.origin}/#person` },
    },
  ],
};
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Miller Bermeo" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Miller Bermeo" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Color del navegador: coincide con --bg de cada tema (lo actualiza el toggle) -->
    <meta name="theme-color" content="#0a0a0c" data-theme-color />
    <meta name="color-scheme" content="dark light" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={onestWoff2} as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!--
      Anti-flash de tema (antes de pintar): oscuro por defecto salvo que el
      usuario haya elegido "light". Marca también `.js` para que los revelados
      solo oculten contenido cuando hay JavaScript.
    -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        let dark = true;
        try {
          dark = localStorage.getItem("theme") !== "light";
        } catch {}
        root.classList.toggle("dark", dark);
        const meta = document.querySelector("meta[data-theme-color]");
        if (meta) meta.setAttribute("content", dark ? "#0a0a0c" : "#f5f5f7");
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>

    <!-- Halo de luz muy sutil que sigue al puntero (decorativo, solo puntero fino) -->
    <CursorGlow />

    <Header />
    <slot />

    <script>
      import "../scripts/animations";
    </script>
  </body>
</html>
